# Copy to .env.local (and add the same variables in Netlify/Vercel > Environment variables). Never commit real values.

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard (/admin). Generate all of these with:  npm run admin:setup -- "your long password"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_TOTP_SECRET=
ANALYTICS_SALT=

# Search engines (optional). Only the code inside content="…" of the HTML tag each one gives you.
# Google Search Console > Add property > URL prefix > HTML tag.  Bing Webmaster Tools > Add site > HTML Meta Tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Locks the donation links: a build fails if the links in site.json don't match this fingerprint.
DONATION_LINKS_SHA256=
